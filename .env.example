# Todas opcionais: cada fonte sem chave fica simplesmente desativada.
# Fontes abertas (Arbeitnow, Remotive, Jobicy) funcionam sem qualquer chave.

# Jooble (agrega milhares de sites, inclui Portugal) -> https://jooble.org/api/about
JOOBLE_API_KEY=

# Careerjet (inclui Portugal, pt_PT) -> https://www.careerjet.com/partners/api
CAREERJET_API_KEY=

# Adzuna (NÃO cobre Portugal; cobre ES, FR, DE, GB, US, BR, IT, NL, BE, CH, CA, AU, PL, AT)
# -> https://developer.adzuna.com/
ADZUNA_APP_ID=
